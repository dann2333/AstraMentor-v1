# 公网部署需要填的东西，一共三行。
# 复制成 deploy/.env 后填好，然后 docker compose -f docker-compose.public.yml up -d

# 你的域名。A 记录（和 IPv6 的 AAAA 记录）要先指到这台机器，
# Caddy 才能申请到证书。
ASTRA_DOMAIN=astra.example.com

# 证书快到期时 Let's Encrypt 给你发信的邮箱
ASTRA_ACME_EMAIL=you@example.com

# 模型密钥。Kimi 的在 https://platform.moonshot.cn/console/api-keys 创建
ASTRA_API_KEY=sk-你的Kimi密钥

# ── 下面都是可选的 ─────────────────────────────────────

# 关掉自助注册（只有你自己用就设成 false），然后用
#   docker compose exec astramentor python -m services.bootstrap_admin <用户名>
# 建号
# ASTRA_REGISTRATION_ENABLED=false

# 登录令牌有效期（小时），默认 48
# ASTRA_AUTH_TOKEN_TTL_HOURS=48

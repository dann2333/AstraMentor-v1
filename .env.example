# AstraMentor 环境变量配置模板
# 复制此文件为 .env 并填入你的 API Key
#
# ─────────────────────────────────────────────────────────────
# 唯一必填项。其余全部有默认值，不填就是 Kimi K3。
# ─────────────────────────────────────────────────────────────

# 模型 API 密钥。Kimi 的在 https://platform.moonshot.cn/console/api-keys 创建。
# 注意：K3 是旗舰模型，需先在开放平台充值（最低 10 元）解锁，
# 新用户注册赠送的代金券不能用于 K3。
ASTRA_API_KEY=sk-你的Kimi密钥

# ─────────────────────────────────────────────────────────────
# 以下都是可选项，注释掉就用默认值
# ─────────────────────────────────────────────────────────────

# 模型提供商，默认 moonshot（Kimi）
# 可选：moonshot / gemini / zhipu / qwen / 任意 OpenAI 兼容端点
# ASTRA_PROVIDER=moonshot

# API 根地址，默认 https://api.moonshot.cn/v1
# 注意只到 /v1，不要追加 /chat/completions
# ASTRA_API_ENDPOINT=https://api.moonshot.cn/v1

# 模型名，默认 kimi-k3
# ASTRA_MODEL_NAME=kimi-k3

# 推理强度，默认 low。仅对支持它的模型生效（Kimi K3：low / high / max）。
# K3 关不掉思考、原厂默认是 max，一次星图生成能想好几分钟；
# 教学场景下 low 的质量完全够用，而且快得多、也省 token。
# ASTRA_REASONING_EFFORT=low

# ========== Gemini 配置示例 ==========
# ASTRA_PROVIDER=gemini
# ASTRA_API_ENDPOINT=http://127.0.0.1:8045
# ASTRA_API_ENDPOINT=https://generativelanguage.googleapis.com
# ASTRA_MODEL_NAME=gemini-3-flash-preview

# ========== 智谱 GLM 配置示例 ==========
# ASTRA_PROVIDER=zhipu
# ASTRA_API_ENDPOINT=https://open.bigmodel.cn/api/paas/v4/
# ASTRA_MODEL_NAME=glm-5

# ========== 通义千问 Qwen 配置示例 ==========
# ASTRA_PROVIDER=qwen
# ASTRA_API_ENDPOINT=https://dashscope.aliyuncs.com/compatible-mode/v1
# ASTRA_MODEL_NAME=qwen3.5-plus

# ========== OpenRouter 配置示例（OpenAI 兼容）==========
# 注意：Endpoint 填 API 根地址，不要追加 /chat/completions
# ASTRA_PROVIDER=openrouter
# ASTRA_API_ENDPOINT=https://openrouter.ai/api/v1
# ASTRA_MODEL_NAME=google/gemini-2.5-flash

# Web Research（联网搜索）开关，默认启用
# ASTRA_WEB_SEARCH_ENABLED=true

# ========== 账号与本地数据存储（SQLite）==========
# SQLite 数据库文件路径，默认 user_data/astramentor.db（首次启动自动创建）
# ASTRA_DB_PATH=user_data/astramentor.db

# 登录令牌有效期（小时），默认 168（7 天）
# ASTRA_AUTH_TOKEN_TTL_HOURS=168

# 连续登录失败多少次后临时锁定账号，0 表示不锁定，默认 8
# ASTRA_AUTH_MAX_FAILED_ATTEMPTS=8

# 账号锁定时长（分钟），默认 15
# ASTRA_AUTH_LOCKOUT_MINUTES=15
